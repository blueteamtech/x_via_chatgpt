APP_NAME="X via ChatGPT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default. On Laravel Cloud, attach a MySQL/Postgres database and use the injected DB_* values.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on Laravel Cloud (HTTPS).
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# X Developer Portal → your app → Keys and tokens / User authentication
X_CLIENT_ID=
X_CLIENT_SECRET=
# Leave empty locally to use APP_URL/auth/x/callback. On Cloud set both APP_URL and this to https.
X_REDIRECT_URI=

# Optional locally (files in storage/). Required on Laravel Cloud so keys survive deploys.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret (dashboard.stripe.com → Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=

# Stripe Payment Link URLs (dashboard → Products → Payment Links)
STRIPE_LINK_PUBLISHER_MONTHLY=
STRIPE_LINK_PUBLISHER_ANNUAL=
STRIPE_LINK_PRO_MONTHLY=
STRIPE_LINK_PRO_ANNUAL=
STRIPE_LINK_POWER_MONTHLY=
STRIPE_LINK_POWER_ANNUAL=

# Stripe Price IDs (dashboard → Products → each product has one or more prices)
STRIPE_PRICE_PUBLISHER_MONTHLY=
STRIPE_PRICE_PUBLISHER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_POWER_MONTHLY=
STRIPE_PRICE_POWER_ANNUAL=
